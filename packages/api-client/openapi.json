  "info": {
    "title": "Вместе API",
    "description": "API первого сквозного сценария MVP",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "example": "2000-05-17"
          }
        },
        "required": [
          "email",
          "password",
          "birthDate"
        ]
      },
      "SessionUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "showAge": {
            "type": "boolean",
            "default": false
          },
          "onboardingCompleted": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id",
          "email",
          "birthDate",
          "showAge",
          "onboardingCompleted"
        ]
      },
      "SessionEnvelopeDto": {
        "type": "object",
        "properties": {
          "sessionToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUserDto"
          }
        },
        "required": [
          "sessionToken",
          "expiresAt",
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "timeZone"
        ]
      },
      "CategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "showAge": {
            "type": "boolean",
            "default": false
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/CityDto"
              }
            ]
          },
          "interests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryDto"
            }
          },
          "onboardingCompleted": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "birthDate",
          "showAge",
          "interests",
          "onboardingCompleted",
          "createdAt",
          "updatedAt"
        ]
      },
      "PatchMeDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "showAge": {
            "type": "boolean"
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          },
          "cityId": {
            "type": "string",
            "format": "uuid"
          },
          "categoryIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "EventSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/CategoryDto"
          },
          "city": {
            "$ref": "#/components/schemas/CityDto"
          },
          "meetingPlace": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "participationMode": {
            "type": "string",
            "enum": [
              "automatic",
              "approval_required"
            ]
          },
          "participantsCount": {
            "type": "number"
          },
          "capacity": {
            "type": "number"
          },
          "isFull": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "cancelled"
            ]
          },
          "contentVersion": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "city",
          "meetingPlace",
          "startsAt",
          "participationMode",
          "participantsCount",
          "capacity",
          "isFull",
          "status",
          "contentVersion"
        ]
      },
      "EventListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventSummaryDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items"
        ]
      },
      "ParticipantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "age": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "displayName"
        ]
      },
      "MyParticipationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "going",
              "rejected",
              "withdrawn",
              "cancelled"
            ]
          },
          "seenEventVersion": {
            "type": "number"
          },
          "hasEventUpdates": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "status",
          "seenEventVersion",
          "hasEventUpdates"
        ]
      },
      "EventDetailsDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/CategoryDto"
          },
          "city": {
            "$ref": "#/components/schemas/CityDto"
          },
          "meetingPlace": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "participationMode": {
            "type": "string",
            "enum": [
              "automatic",
              "approval_required"
            ]
          },
          "participantsCount": {
            "type": "number"
          },
          "capacity": {
            "type": "number"
          },
          "isFull": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "cancelled"
            ]
          },
          "contentVersion": {
            "type": "number"
          },
          "description": {
            "type": "string"
          },
          "organizer": {
            "$ref": "#/components/schemas/ParticipantDto"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParticipantDto"
            }
          },
          "version": {
            "type": "number"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "myParticipation": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/MyParticipationDto"
              }
            ]
          },
          "availableActions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "city",
          "meetingPlace",
          "startsAt",
          "participationMode",
          "participantsCount",
          "capacity",
          "isFull",
          "status",
          "contentVersion",
          "description",
          "organizer",
          "participants",
          "version",
          "createdAt",
          "updatedAt",
          "availableActions"
        ]
      },
      "JoinEventDto": {
        "type": "object",
        "properties": {
          "participation": {
            "$ref": "#/components/schemas/MyParticipationDto"
          },
          "participantsCount": {
            "type": "number"
          },
          "capacity": {
            "type": "number"
          },
          "isFull": {
            "type": "boolean"
          }
        },
        "required": [
          "participation",
          "participantsCount",
          "capacity",
          "isFull"
        ]
      }
    }
  }
}
