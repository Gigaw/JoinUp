{
  "expo": {
    "name": "Вместе",
    "slug": "vmeste",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vmeste",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.vmeste.mobile"
    },
    "android": {
      "package": "app.vmeste.mobile"
    }
  }
}
