generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  draft
  published
  cancelled
  completed
  hidden

  @@map("event_status")
}

enum ParticipationMode {
  automatic
  approval_required

  @@map("participation_mode")
}

enum ParticipationStatus {
  pending
  going
  rejected
  withdrawn
  cancelled

  @@map("participation_status")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(254)
  passwordHash        String               @map("password_hash")
  birthDate           DateTime             @map("birth_date") @db.Date
  displayName         String?              @map("display_name") @db.VarChar(80)
  showAge             Boolean              @default(false) @map("show_age")
  avatarObjectKey     String?              @map("avatar_object_key")
  bio                 String?              @db.VarChar(500)
  cityId              String?              @map("city_id") @db.Uuid
  onboardingCompleted Boolean              @default(false) @map("onboarding_completed")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  city                City?                @relation(fields: [cityId], references: [id])
  sessions            AuthSession[]
  organizedEvents     Event[]              @relation("EventOrganizer")
  participations      EventParticipation[]
  interests           UserInterest[]
  idempotencyRecords  IdempotencyRecord[]

  @@map("users")
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("auth_sessions")
}

model City {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  timeZone    String   @map("time_zone") @db.VarChar(80)
  isSupported Boolean  @default(true) @map("is_supported")
  sortOrder   Int      @default(0) @map("sort_order")
  users       User[]
  events      Event[]

  @@map("cities")
}

model Category {
  id        String         @id @default(uuid()) @db.Uuid
  slug      String         @unique @db.VarChar(80)
  name      String         @db.VarChar(120)
  isActive  Boolean        @default(true) @map("is_active")
  sortOrder Int            @default(0) @map("sort_order")
  events    Event[]
  interests UserInterest[]

  @@map("categories")
}

model UserInterest {
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([userId, categoryId])
  @@map("user_interests")
}

model Event {
  id                String               @id @default(uuid()) @db.Uuid
  organizerId       String               @map("organizer_id") @db.Uuid
  cityId            String               @map("city_id") @db.Uuid
  categoryId        String               @map("category_id") @db.Uuid
  title             String               @db.VarChar(80)
  description       String               @db.VarChar(2000)
  meetingPlace      String               @map("meeting_place") @db.VarChar(300)
  startsAt          DateTime             @map("starts_at") @db.Timestamptz
  endsAt            DateTime?            @map("ends_at") @db.Timestamptz
  capacity          Int
  participationMode ParticipationMode    @map("participation_mode")
  status            EventStatus          @default(published)
  version           Int                  @default(1)
  contentVersion    Int                  @default(1) @map("content_version")
  imageObjectKey    String?              @map("image_object_key")
  cancelledAt       DateTime?            @map("cancelled_at") @db.Timestamptz
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz
  organizer         User                 @relation("EventOrganizer", fields: [organizerId], references: [id])
  city              City                 @relation(fields: [cityId], references: [id])
  category          Category             @relation(fields: [categoryId], references: [id])
  participations    EventParticipation[]

  @@index([cityId, status, startsAt, id])
  @@index([organizerId, startsAt])
  @@index([categoryId, startsAt])
  @@map("events")
}

model EventParticipation {
  id               String              @id @default(uuid()) @db.Uuid
  eventId          String              @map("event_id") @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  status           ParticipationStatus
  seenEventVersion Int                 @map("seen_event_version")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz
  statusChangedAt  DateTime            @default(now()) @map("status_changed_at") @db.Timestamptz
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  event            Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status, createdAt])
  @@index([userId, status, updatedAt])
  @@map("event_participations")
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  operation      String    @db.VarChar(120)
  key            String    @db.VarChar(128)
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  resourceId     String?   @map("resource_id") @db.Uuid
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, key])
  @@map("idempotency_records")
}
