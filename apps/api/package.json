{
  "name": "@vmeste/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/e2e/**'",
    "test:e2e": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "openapi:export": "nest build && node dist/platform/openapi/export-openapi.js"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/static": "9.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.15.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fastify": "5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/node": "^22.17.2",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.2.1",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
